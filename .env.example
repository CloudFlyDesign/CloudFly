# Copy to .env and fill in your Atlas values
MONGODB_USERNAME=your_db_user
MONGODB_PASSWORD=your_password
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/cloudfly?retryWrites=true&w=majority
PORT=3000
TIGER_DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
FISH_API_KEY=sk-fish-...
